<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="storex-logging-service"/>

    <!-- Pattern chung: Tích hợp biến MDC %X{requestId} (BÀI TẬP 2) -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{requestId:-SYSTEM}] %-5level %logger{36} - %msg%n" />
    <property name="LOG_DIR" value="logs" />

    <!-- 1. Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 2. BÀI TẬP 4: RollingFileAppender - Chống tràn ổ cứng VPS -->
    <appender name="ROLLING_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/application.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- Xoay vòng theo ngày và chỉ số index, nén GZIP .gz tiết kiệm 90% ổ cứng -->
            <fileNamePattern>${LOG_DIR}/application-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <!-- Mỗi file tối đa 10MB -->
            <maxFileSize>10MB</maxFileSize>
            <!-- Giữ lịch sử 30 ngày gần nhất -->
            <maxHistory>30</maxHistory>
            <!-- Tổng dung lượng cả thư mục log tối đa 3GB -->
            <totalSizeCap>3GB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 3. BÀI TẬP 3: Custom Discord Webhook Appender - Cảnh báo tức thời log ERROR -->
    <appender name="DISCORD" class="com.storex.logging.appender.DiscordAppender">
        <webhookUrl>${DISCORD_WEBHOOK_URL:-https://discord.com/api/webhooks/dummy/test}</webhookUrl>
        <applicationName>${appName}</applicationName>
    </appender>

    <!-- Bọc Discord Appender bằng AsyncAppender để non-blocking luồng chính -->
    <appender name="ASYNC_DISCORD" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="DISCORD" />
        <queueSize>512</queueSize>
        <neverBlock>true</neverBlock>
    </appender>

    <!-- Root Logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="ROLLING_FILE" />
        <appender-ref ref="ASYNC_DISCORD" />
    </root>

</configuration>
